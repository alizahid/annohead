    "search": {
      "box": {
        "placeholder": "Search"
      },
      "filters": {
        "all": "All",
        "building": "Buildings",
        "chain": "Production chains",
        "item": "Items",
        "product": "Products",
        "quest": "Quests",
        "tech": "Technologies"
